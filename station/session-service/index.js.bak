const express = require('express');
const Database = require('better-sqlite3');
const { v4: uuidv4 } = require('uuid');
const cors = require('cors');
const { WebSocketServer } = require('ws');
const mqtt = require('mqtt');
const http = require('http');

const app = express();
app.use(cors());
app.use(express.json());

const DB_PATH = process.env.DB_PATH || '/data/gramai.db';
const MQTT_BROKER = process.env.MQTT_BROKER || 'mosquitto';
const PORT = process.env.PORT || 3002;

// In-memory session store
const sessions = {};

function getDb() {
    return new Database(DB_PATH);
}

// Connect to MQTT
const mqttClient = mqtt.connect(`mqtt://${MQTT_BROKER}:1883`);

mqttClient.on('connect', () => {
    console.log('Session service connected to MQTT broker');
    mqttClient.subscribe('gramai/diagnosis/result');
    mqttClient.subscribe('gramai/diagnosis/question');
});

mqttClient.on('error', (err) => {
    console.error('MQTT error:', err.message);
});

// WebSocket server for real-time session updates
const server = http.createServer(app);
const wss = new WebSocketServer({ server, path: '/ws' });

const wsClients = new Map();

wss.on('connection', (ws, req) => {
    const sessionId = new URL(req.url, 'http://localhost').searchParams.get('session_id');
    if (sessionId) {
        wsClients.set(sessionId, ws);
        console.log(`WebSocket client connected for session: ${sessionId}`);
    }

    ws.on('close', () => {
        for (const [id, client] of wsClients.entries()) {
            if (client === ws) {
                wsClients.delete(id);
                break;
            }
        }
    });

    ws.on('message', (data) => {
        try {
            const msg = JSON.parse(data.toString());
            if (msg.type === 'diagnosis_answer' && msg.session_id) {
                mqttClient.publish('gramai/diagnosis/answer', JSON.stringify({
                    session_id: msg.session_id,
                    answer: msg.answer
                }));
            }
        } catch (err) {
            console.error('WS message error:', err);
        }
    });
});

function sendToSession(sessionId, data) {
    const ws = wsClients.get(sessionId);
    if (ws && ws.readyState === 1) {
        ws.send(JSON.stringify(data));
    }
}

mqttClient.on('message', (topic, payload) => {
    try {
        const data = JSON.parse(payload.toString());
        if (topic === 'gramai/diagnosis/result' && data.session_id) {
            const session = sessions[data.session_id];
            if (session) {
                session.diagnosis = data;
                session.status = 'completed';
                saveSessionToDb(data.session_id);
            }
            sendToSession(data.session_id, { type: 'diagnosis_result', data });
        }
        if (topic === 'gramai/diagnosis/question' && data.session_id) {
            sendToSession(data.session_id, { type: 'diagnosis_question', data });
        }
    } catch (err) {
        console.error('MQTT message error:', err);
    }
});

function saveSessionToDb(sessionId) {
    const session = sessions[sessionId];
    if (!session) return;

    const db = getDb();
    try {
        const existing = db.prepare('SELECT id FROM visits WHERE id = ?').get(sessionId);
        if (existing) {
            db.prepare(`
                UPDATE visits SET
                    risk_level = ?,
                    diagnosis_hindi = ?,
                    diagnosis_english = ?,
                    what_to_do = ?,
                    doctor_type = ?,
                    completed_at = CURRENT_TIMESTAMP
                WHERE id = ?
            `).run(
                session.diagnosis?.diagnosis?.risk_level || null,
                session.diagnosis?.diagnosis?.summary_hindi || null,
                session.diagnosis?.diagnosis?.summary_english || null,
                session.diagnosis?.diagnosis?.what_to_do || null,
                session.diagnosis?.diagnosis?.doctor_type || null,
                sessionId
            );
        } else {
            db.prepare(`
                INSERT INTO visits (id, patient_id, session_type, risk_level, diagnosis_hindi, diagnosis_english, what_to_do, doctor_type, simulation_mode)
                VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
            `).run(
                sessionId,
                session.patient_id,
                session.session_type,
                session.diagnosis?.diagnosis?.risk_level || null,
                session.diagnosis?.diagnosis?.summary_hindi || null,
                session.diagnosis?.diagnosis?.summary_english || null,
                session.diagnosis?.diagnosis?.what_to_do || null,
                session.diagnosis?.diagnosis?.doctor_type || null,
                session.simulation_mode ? 1 : 0
            );
        }

        // Save sensor readings
        for (const reading of session.readings) {
            db.prepare(`
                INSERT OR IGNORE INTO sensor_readings (visit_id, sensor_type, value_json, quality_score)
                VALUES (?, ?, ?, ?)
            `).run(sessionId, reading.sensor_type, JSON.stringify(reading.value), reading.quality_score || 1.0);
        }

        // Add to sync queue
        db.prepare(`
            INSERT OR IGNORE INTO sync_queue (visit_id) VALUES (?)
        `).run(sessionId);

    } catch (err) {
        console.error('Save session error:', err);
    } finally {
        db.close();
    }
}

// Health check
app.get('/health', (req, res) => {
    res.json({ status: 'ok', service: 'session-service', active_sessions: Object.keys(sessions).length });
});

// POST /sessions/start
app.post('/sessions/start', (req, res) => {
    const { patient_id, session_type, simulation_mode, simulation_dataset } = req.body;

    if (!patient_id || !session_type) {
        return res.status(400).json({ error: 'patient_id and session_type required' });
    }

    const session_id = uuidv4();
    sessions[session_id] = {
        id: session_id,
        patient_id,
        session_type,
        simulation_mode: simulation_mode || false,
        simulation_dataset: simulation_dataset || 'green',
        status: 'active',
        current_step: 1,
        readings: [],
        diagnosis: null,
        started_at: new Date().toISOString()
    };

    // Create visit record immediately
    const db = getDb();
    try {
        db.prepare(`
            INSERT INTO visits (id, patient_id, session_type, simulation_mode)
            VALUES (?, ?, ?, ?)
        `).run(session_id, patient_id, session_type, simulation_mode ? 1 : 0);
    } catch (err) {
        console.error('Create visit error:', err);
    } finally {
        db.close();
    }

    // Publish session start event
    mqttClient.publish('gramai/session/events', JSON.stringify({
        type: 'session_started',
        session_id,
        patient_id,
        session_type,
        timestamp: Date.now()
    }));

    res.status(201).json({ success: true, session_id, session: sessions[session_id] });
});

// POST /sessions/:id/reading
app.post('/sessions/:id/reading', (req, res) => {
    const { id } = req.params;
    const { sensor_type, value, quality_score } = req.body;

    if (!sessions[id]) {
        return res.status(404).json({ error: 'Session not found' });
    }

    sessions[id].readings.push({ sensor_type, value, quality_score: quality_score || 1.0 });

    res.json({ success: true, readings_count: sessions[id].readings.length });
});

// POST /sessions/:id/step
app.post('/sessions/:id/step', (req, res) => {
    const { id } = req.params;
    const { step } = req.body;

    if (!sessions[id]) {
        return res.status(404).json({ error: 'Session not found' });
    }

    sessions[id].current_step = step;
    res.json({ success: true, current_step: step });
});

// POST /sessions/:id/complete
app.post('/sessions/:id/complete', (req, res) => {
    const { id } = req.params;

    if (!sessions[id]) {
        return res.status(404).json({ error: 'Session not found' });
    }

    sessions[id].status = 'awaiting_diagnosis';

    if (sessions[id].simulation_mode) {
        const dataset = sessions[id].simulation_dataset || 'green';
        const diagMap = {
            green: { risk_level: 'GREEN', summary_hindi: 'आपका स्वास्थ्य अच्छा है।', summary_english: 'All parameters normal.', what_to_do: '30 दिनों में दोबारा जांच करवाएं।', what_to_do_english: 'Get a checkup again in 30 days. Maintain a healthy lifestyle.', doctor_type: null, return_in_days: 30 },
            yellow: { risk_level: 'YELLOW', summary_hindi: 'आपका रक्तचाप थोड़ा अधिक है।', summary_english: 'Blood pressure slightly elevated.', what_to_do: 'नमक कम खाएं। 15 दिनों में दोबारा जांच करवाएं।', what_to_do_english: 'Reduce salt intake. See a doctor within 15 days.', doctor_type: 'General Physician', return_in_days: 15 },
            red: { risk_level: 'RED', summary_hindi: 'आपका रक्तचाप बहुत अधिक है। तुरंत डॉक्टर से मिलें।', summary_english: 'High BP and low SpO2. Immediate attention required.', what_to_do: 'तुरंत नजदीकी अस्पताल जाएं।', what_to_do_english: 'Go to the nearest hospital immediately. Do not delay.', doctor_type: 'Cardiologist', return_in_days: 1 }
        };
        const diag = diagMap[dataset] || diagMap.green;
        setTimeout(function() {
            const result = { session_id: id, diagnosis: diag, confidence: 0.95, simulation: true };
            mqttClient.publish('gramai/diagnosis/result', JSON.stringify(result));
            console.log('Simulation diagnosis published for session', id, 'dataset:', dataset);
        }, 2000);
    }

    // Publish to trigger AIAC loop
    mqttClient.publish('gramai/session/complete', JSON.stringify({
        session_id: id,
        patient_id: sessions[id].patient_id,
        session_type: sessions[id].session_type,
        readings: sessions[id].readings,
        simulation_mode: sessions[id].simulation_mode,
        timestamp: Date.now()
    }));

    res.json({ success: true, status: 'awaiting_diagnosis' });
});

// GET /sessions/:id
app.get('/sessions/:id', (req, res) => {
    const { id } = req.params;

    if (!sessions[id]) {
        return res.status(404).json({ error: 'Session not found' });
    }

    res.json({ success: true, session: sessions[id] });
});

// POST /sessions/:id/phq9
app.post('/sessions/:id/phq9', (req, res) => {
    const { id } = req.params;
    const { answers } = req.body;

    if (!sessions[id]) {
        return res.status(404).json({ error: 'Session not found' });
    }

    if (!answers || answers.length !== 9) {
        return res.status(400).json({ error: 'Exactly 9 PHQ-9 answers required' });
    }

    const total = answers.reduce((sum, a) => sum + a, 0);
    let severity, risk_level;

    if (total <= 4) { severity = 'Minimal'; risk_level = 'GREEN'; }
    else if (total <= 9) { severity = 'Mild'; risk_level = 'YELLOW'; }
    else if (total <= 14) { severity = 'Moderate'; risk_level = 'YELLOW'; }
    else if (total <= 19) { severity = 'Moderately Severe'; risk_level = 'RED'; }
    else { severity = 'Severe'; risk_level = 'RED'; }

    sessions[id].phq9 = { answers, total, severity, risk_level };

    const db = getDb();
    try {
        answers.forEach((score, index) => {
            db.prepare(`
                INSERT INTO phq9_responses (visit_id, question_number, answer_score)
                VALUES (?, ?, ?)
            `).run(id, index + 1, score);
        });
    } catch (err) {
        console.error('PHQ9 save error:', err);
    } finally {
        db.close();
    }

    res.json({ success: true, total, severity, risk_level });
});

server.listen(PORT, '0.0.0.0', () => {
    console.log(`Session service running on port ${PORT}`);
});
